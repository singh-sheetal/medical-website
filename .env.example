# ─────────────────────────────────────────────────────────────
# MedicalOS — Environment Variables
# Copy this file to .env.local and fill in your values.
# Set these in Vercel dashboard for production.
# Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── Site URL ──────────────────────────────────────────────────
# Your production domain once connected in Vercel
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Google Analytics 4 ────────────────────────────────────────
# Get from: https://analytics.google.com
# Format: G-XXXXXXXXXX
# Leave empty to disable analytics entirely
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Booking / Calendar ────────────────────────────────────────
# Your Cal.com, Calendly, or custom booking page URL
# Used for all "Book a Demo" CTAs across the site
NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-name/demo
